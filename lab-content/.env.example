# ─────────────────────────────────────────────────────────────
# Confluent Cloud credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# Kafka Cluster — from Confluent Cloud → cluster_0 → Cluster Settings
BOOTSTRAP_SERVERS=pkc-xxxxx.<region>.gcp.confluent.cloud:9092

# Kafka API Key — from Confluent Cloud → API Keys (Kafka cluster scope)
SASL_USERNAME=<your-kafka-api-key>
SASL_PASSWORD=<your-kafka-api-secret>

# Schema Registry — from Confluent Cloud → Environments → default → Schema Registry
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.<region>.gcp.confluent.cloud

# Schema Registry API Key — from Confluent Cloud → API Keys (Schema Registry scope)
SCHEMA_REGISTRY_KEY=<your-schema-registry-key>
SCHEMA_REGISTRY_SECRET=<your-schema-registry-secret>
